# Frontend-only environment variables for the DayLy React app.
# Do not put Canvas tokens or Supabase service-role keys in this file.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for the built-in Spotify workspace player.
VITE_SPOTIFY_CLIENT_ID=
# Optional: defaults to the current app URL.
VITE_SPOTIFY_REDIRECT_URI=
# Optional: leave blank in local dev to use the Vite /api/canvas-scan route.
VITE_CANVAS_SCAN_URL=
# Optional: override the default Supabase AI planner function URL.
VITE_AI_PLAN_URL=
# Optional: override the default Supabase AI task capture function URL.
VITE_AI_CAPTURE_URL=
